{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "packageRules": [
    {
      "description": "Do not update the Go version",
      "matchDatasources": [
        "golang-version"
      ],
      "enabled": false
    },
    {
      "description": "Update Fiano module tags only",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "github.com/qemus/fiano"
      ],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+-\\d+$/",
      "ignoreUnstable": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)go\\.mod$/"
      ],
      "matchStrings": [
        "replace github\\.com/linuxboot/fiano => github\\.com/qemus/fiano (?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "github.com/qemus/fiano",
      "packageNameTemplate": "https://github.com/qemus/fiano.git",
      "versioningTemplate": "semver"
    }
  ]
}
